# VaakuOS / Instacal abandoned-cart + behaviour tracking
# Point at the BACKEND (default http://localhost:3001), NOT the storefront (8080).
VITE_VAAKUOS_API_URL=http://localhost:3001

# index.html loads: %VITE_VAAKUOS_API_URL%/sdk/vaakuos-cart.js
# Prefer website write key (vw_live_…) + site id; sk_* tenant keys also work for carts.
VITE_VAAKUOS_WRITE_KEY=
VITE_VAAKUOS_API_KEY=
VITE_VAAKUOS_SITE_ID=
