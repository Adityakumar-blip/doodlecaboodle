# VaakuOS abandoned-cart + visitor tracking
# Point at the BACKEND (default http://localhost:3001), NOT the storefront (8080).
# Must be set at build time in production — Vite bakes it into index.html.
VITE_VAAKUOS_API_URL=http://localhost:3001

# Website write key (vw_…) from VaakuOS → Integrations → Custom website.
VITE_VAAKUOS_WRITE_KEY=
